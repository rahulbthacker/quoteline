# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model per role: provider:model, comma-separated fallback chain (first is tried first).
# A failed call is retried once, then the next entry is tried; if the chain is
# exhausted the item is flagged needs_review / model_error, never dropped.
EXTRACT_PRIMARY=anthropic:claude-opus-5-5
EXTRACT_SECONDARY=gemini:gemini-3.1-pro-preview
JUDGE=anthropic:claude-opus-5-5
ROUTER=anthropic:claude-haiku-4-5
ANALYST=anthropic:claude-opus-5-5

# USD->INR rate used only to express model spend in rupees in the Run inspector.
COST_USD_INR=83.42
